{
  "permissions": {
    "allow": [
      "Bash(php artisan test:*)",
      "Bash(php artisan migrate)",
      "Bash(php artisan route:list:*)",
      "Bash(php vendor/bin/pint:*)",
      "Bash(composer dump-autoload:*)",
      "Bash(npm run build:*)",
      "Bash(git status:*)",
      "Bash(git --no-pager diff:*)",
      "Bash(git --no-pager log:*)",
      "Bash(git --no-pager show:*)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git clean:*)",
      "Bash(php artisan migrate:fresh:*)",
      "Bash(php artisan migrate:reset:*)",
      "Bash(php artisan migrate:rollback:*)",
      "Bash(php artisan db:wipe:*)"
    ]
  }
}
